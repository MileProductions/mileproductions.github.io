# Publiczny adres backendu (subdomena konfiguratora). Od niego zależą linki w mailach.
PUBLIC_URL=https://projektuj.krowki24.pl
# PORT=8080
# Gdzie trzymać bazę (SQLite) i pliki projektów. W Dockerze: wolumen /data.
# DATA_DIR=./data   (w Dockerze nie ustawiaj – obraz używa wolumenu /data)
# Adres, na który wraca klient po kliknięciu linku z maila. Domyślnie konfigurator na PUBLIC_URL.
# DESIGNER_URL=https://projektuj.krowki24.pl/
# Domeny, które mogą wołać API (gdy konfigurator jest osadzony jako <krowka-designer> na stronie sklepu).
ALLOWED_ORIGINS=https://krowki24.pl,https://www.krowki24.pl

# Poczta (SMTP). Bez tego maile trafiają tylko do logu i DATA_DIR/outbox.
# SMTP_URL=smtps://uzytkownik:haslo@smtp.example.pl:465
MAIL_FROM="Krówki24 – projekty <projekty@krowki24.pl>"
# Kto dostaje powiadomienie o nowym projekcie (po przecinku)
NOTIFY_EMAIL=grafik@krowki24.pl
BRAND_NAME=Krówki24.pl

# Newsletter: zgoda pokazywana przy zapisie i (opcjonalnie) webhook do narzędzia wysyłek
CONSENT_TEXT="Zapisuję się do newslettera Krówki24.pl i chcę otrzymywać informacje o ofercie i promocjach. Wiem, że mogę się wypisać w każdej chwili."
PRIVACY_URL=https://krowki24.pl/pl/i/Polityka-prywatnosci/
# NEWSLETTER_WEBHOOK_URL=https://hook.eu1.make.com/...

# Strona produktu w Shoperze, gdzie klient zamawia z numerem projektu
SHOP_PRODUCT_URL=https://krowki24.pl/pl/p/Krowki-z-wlasnym-projektem/

# Druk: profil ICC dla CMYK (w obrazie Dockera jest FOGRA39L z pakietu colord-data).
# Jeśli drukarnia poda własny profil (np. ISOcoated_v2_eci.icc albo PSO Uncoated), wskaż go tutaj.
ICC_PROFILE=/usr/share/color/icc/colord/FOGRA39L_coated.icc
ICC_NAME="FOGRA39 (ISO 12647-2:2004, Coated)"
# 0 = percepcyjny (zdjęcia), 1 = kolorymetryczny względny
RENDER_INTENT=0

# Limity i RODO
MAX_FILE_MB=30
RETENTION_DAYS=365
SESSION_DAYS=90
